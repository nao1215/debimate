#!/usr/bin/env bash
# push する範囲で変えたノートが、規則と総合 4 以上の点の記録を満たすかを見る（notes-quality/gate.py push）。
root="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  python3 "$root/notes-quality/gate.py" push "$remote_sha" "$local_sha" || status=1
done
exit $status
