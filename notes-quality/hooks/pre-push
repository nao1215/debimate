#!/usr/bin/env bash
# push する範囲で変えた技術ノート・ML ノートが、規則と総合 4 以上の点の記録を満たすかを見る。
# ノートを含まない push（記事・weeknotes だけ）では何もしない。
root="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  range="$remote_sha..$local_sha"; [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && range="$local_sha~1..$local_sha"
  git diff --name-only "$range" | grep -qE '^(content/notes/|projects/ml/notes/)' || continue
  python3 "$root/notes-quality/gate.py" push "$remote_sha" "$local_sha" || status=1
done
exit $status
