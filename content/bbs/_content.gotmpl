{{/* data/bbs.json (scripts/fetch_bbs.py が生成) から /bbs/<number>/ を作る。Hugo はデータファイルのキーを小文字化するので createdat のように参照する */}}
{{- range hugo.Data.bbs.threads }}
{{- $path := string (int .number) }}
{{- $page := dict
  "path" $path
  "kind" "page"
  "title" .title
  "date" (time.AsTime .createdat)
  "lastmod" (time.AsTime .lastactivityat)
  "description" (printf "%s さんが立てた話題。コメント %d 件" .author.login (int .commentcount))
  "params" (dict
    "thread" .
    "hideMeta" true
    "ShowToc" false
    "disableShare" true
    "disableRelatedPosts" true
    "disableAdsense" true
  )
}}
{{- $.AddPage $page }}
{{- end }}
