{{- /*
  検索索引（/search/ の fastsearch.js が読む /index.json）。

  1 レコードの単位はページではなく「検索結果として見せたい塊」にする。

  - 記事（post）: 1 記事 1 レコード
  - 技術ノート（notes・ml）: 1 ページ 1 レコード。h2/h3 を headings に入れ、
    どの見出しで当たったかを結果に出せるようにする
  - Weeknotes: 週ではなく話題（h4）ごとに 1 レコード。URL は話題ページ
    （/weeknotes/2026-09-21/xxxx/）を指し、parent_title に週の題を入れる。
    週単位だと「2026/09/14週」としか出ず、検索語との関係が見えなかった

  本文は先頭 3,000 文字までに切る。全文を入れると索引が数 MB になり、
  検索ページを開くたびに丸ごとダウンロードする事になる。

  .Scratch ではなく slice / append で組むのは、.Scratch がページに紐づいて
  残り、hugo server のリビルドで結果が重複するため。
*/ -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
  {{- if or .Params.searchHidden (eq .Layout "archives") (eq .Layout "search") (eq .Section "weeknotes") -}}
    {{- continue -}}
  {{- end -}}
  {{- $type := "page" -}}
  {{- if eq .Section "post" }}{{ $type = "post" }}{{ else if in (slice "notes" "ml") .Section }}{{ $type = "note" }}{{ end -}}
  {{- $headings := slice -}}
  {{- if eq $type "note" -}}
    {{- range findRE `(?s)<h[23]\b[^>]*>.*?</h[23]>` .Content -}}
      {{- $headings = $headings | append (. | plainify | htmlUnescape | strings.TrimSpace) -}}
    {{- end -}}
  {{- end -}}
  {{- $parent := "" -}}
  {{- if and (eq $type "note") .Parent -}}
    {{- $parent = .Parent.Params.cardLabel | default .Parent.Title -}}
  {{- end -}}
  {{- $plain := .Plain | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
  {{- $index = $index | append (dict
    "type" $type
    "title" .Title
    "parent_title" $parent
    "url" .RelPermalink
    "date" (.Date.Format "2006-01-02")
    "headings" $headings
    "content" (substr $plain 0 3000)) -}}
{{- end -}}
{{- range partial "weeknotes/topics.html" . -}}
  {{- if .page.Draft }}{{ continue }}{{ end -}}
  {{- $plain := .body | plainify | htmlUnescape | replaceRE "\\s+" " " | strings.TrimSpace -}}
  {{- $index = $index | append (dict
    "type" "weeknotes"
    "title" .page.Title
    "parent_title" .week.Title
    "url" .page.RelPermalink
    "date" (.week.Date.Format "2006-01-02")
    "headings" (slice)
    "content" (substr $plain 0 3000)) -}}
{{- end -}}
{{- $index | jsonify -}}
